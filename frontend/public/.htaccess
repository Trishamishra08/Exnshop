# Exnshop SPA — Hostinger (Apache / LiteSpeed)
# Upload the FULL dist/ folder to public_html, including this hidden .htaccess.
# In File Manager: enable "Show hidden files" before uploading.

DirectoryIndex index.html

# Hostinger uses 404.html as the custom error page (build copies SPA into it)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files as-is (js, css, images, fonts, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Keep directories that already have index.html (route stubs from build)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # All other routes (incl. /product/123, /orders/abc) → SPA
  RewriteRule . /index.html [L]
</IfModule>
