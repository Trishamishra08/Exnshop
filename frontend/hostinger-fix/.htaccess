# Exnshop SPA — Hostinger / LiteSpeed
# Critical: do NOT skip directories (-d). Empty admin/seller/delivery folders
# on the server would otherwise return 404 and break panel routes.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never rewrite real files (js/css/images/fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # All app routes (including /admin /seller /delivery) -> SPA
  RewriteRule ^ index.html [L]
</IfModule>

# If rewrite misses, still serve the SPA
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|404\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
