# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Server & Process
NODE_ENV=production
PORT=5000
PROCESS_ROLE=all
HOSTNAME=localhost
SERVER_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
APP_NAME=Olovely Total Suvidha

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRES_IN=7d

# SMS Gateway (SMS India HUB)
SMS_INDIA_HUB_USERNAME=your_username
SMS_INDIA_HUB_PASSWORD=your_password
SMS_INDIA_HUB_API_KEY=your_api_key
SMS_INDIA_HUB_SENDER_ID=your_sender_id
SMS_INDIA_HUB_DLT_TEMPLATE_ID=your_dlt_template_id
SMS_INDIA_HUB_ENTITY_ID=your_entity_id

# Firebase Admin Push Notifications
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Google Cloud Translation API (Backend Only)
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translate_api_key_here
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=config/google-cloud-credentials.json

